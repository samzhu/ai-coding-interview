# AI API Keys
# 複製此檔為 application-secrets.properties 並填入實際值（已加入 .gitignore）。
aci-google-genai-api-key=your-google-genai-api-key
aci-anthropic-api-key=your-anthropic-api-key

# OAuth2（aci.security.enabled=true 時需要）
aci-oauth2-issuer-uri=https://auth-dev.omnihubs.cloud
aci-security-enabled=true

# CORS（選填，預設允許 localhost:3000 和 localhost:3001）
# aci-cors-allowed-origins=https://admin.example.com,https://candidate.example.com
