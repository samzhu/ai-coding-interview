# ===================================================
# AI 面試平台環境變數設定範本
# 複製此檔案為 .env 並填入實際值
# ===================================================

# PostgreSQL 資料庫
POSTGRES_PASSWORD=your_secure_password_here

# Google Gemini AI API Key（用於 aci.models 中所有 google-genai 模型）
# 取得方式：https://aistudio.google.com/app/apikey
# 支援模型：gemini-2.5-flash, gemini-2.0-flash 等（見 application.yml aci.models）
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Admin API 靜態 Bearer Token（留空則不啟用認證）
# 用於保護 /api/v1/admin/** 路徑
ADMIN_TOKEN=your_admin_token_here

# Docker Remote API（程式碼執行沙箱）
# 本地開發：tcp://localhost:2375（compose.yaml 中的 DinD，Spring Boot 自動啟動）
# 正式環境：tcp://<gce-vm-ip>:2376（TLS，需搭配 DOCKER_TLS_VERIFY 和 DOCKER_CERT_PATH）
# DOCKER_HOST=tcp://localhost:2375
# DOCKER_TLS_VERIFY=false
# DOCKER_CERT_PATH=

# 執行沙箱 Docker image（預設 eclipse-temurin:25-jdk）
# EXECUTION_DOCKER_IMAGE=eclipse-temurin:25-jdk

# Spring Boot profile（可選）
# lab：部署到 Cloud Run，使用 StubCodeExecutor（暫用 stub，等待遠端 Docker daemon 就緒）
# SPRING_PROFILES_ACTIVE=lab
