{
  "name": "interview-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:candidate": "npm run dev --workspace=apps/candidate -- --port 3001",
    "build:admin": "npm run build --workspace=apps/admin",
    "build:candidate": "npm run build --workspace=apps/candidate",
    "build:export:admin": "npm run build:export --workspace=apps/admin",
    "build:export:candidate": "npm run build:export --workspace=apps/candidate"
  }
}
